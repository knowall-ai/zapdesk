# ZapDesk Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# NextAuth Configuration
# =============================================================================
NEXTAUTH_URL=http://localhost:3102
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32

# =============================================================================
# Azure AD Configuration (Microsoft Authentication)
# =============================================================================
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-tenant-id
# Set to true to let admins of other Entra tenants install ZapDesk through
# /install. The app registration must then be multi-tenant.
# AZURE_AD_MULTI_TENANT=true
# Organisations allowed to use ZapDesk: comma-separated Entra tenant IDs
# (GUIDs). The KnowAll tenant is always allowed, and so is AZURE_AD_TENANT_ID
# when it is a tenant ID (GUID); `common` or `organizations` approves no one.
# Anyone signed in from another tenant only sees the "not set up yet" page.
# APPROVED_TENANT_IDS=00000000-0000-0000-0000-000000000000,11111111-1111-1111-1111-111111111111

# =============================================================================
# Azure DevOps Configuration
# =============================================================================
# Default organization, for requests that do not name one (email ingest, SLA
# and routing lookups). Users still pick their organization in the header.
# There is no built-in default.
AZURE_DEVOPS_ORG=your-devops-organization
AZURE_DEVOPS_PAT=your-personal-access-token-for-service-account

# =============================================================================
# Email Configuration (Microsoft Graph)
# =============================================================================
# ZapDesk uses Microsoft Graph for both directions:
#   - Outbound: client-credentials flow + Mail.Send to send replies
#   - Inbound:  client-credentials flow + Mail.ReadWrite to poll the support
#               mailbox every minute (no Power Automate / Logic App needed)
#
# Use a dedicated Azure AD app for mail (with Mail.Send + Mail.ReadWrite
# Application permissions) and scope it to one mailbox via Exchange
# Application Access Policy for least privilege. The app falls back to the
# main AZURE_AD_* credentials if the MAIL_* ones aren't set.

# Shared secret protecting POST /api/email/poll and POST /api/email/webhook.
EMAIL_WEBHOOK_SECRET=your-email-webhook-secret

# Mailbox ZapDesk polls for inbound mail (UPN or shared-mailbox SMTP address).
MAIL_POLL_MAILBOX=support@yourdomain.com

# Outbound sender — typically the same as MAIL_POLL_MAILBOX.
MAIL_FROM=support@yourdomain.com
MAIL_FROM_NAME=ZapDesk Support

# Dedicated Azure AD app credentials for mail (recommended).
MAIL_TENANT_ID=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=

# Support team notified about every new ticket that arrives by email (#485),
# and about customer replies on tickets nobody has picked up yet. One address
# (a group or distribution list) or several separated by commas or semicolons.
#
# Must NOT be MAIL_POLL_MAILBOX. Mail sent to the address ZapDesk polls is read
# straight back in, and since every ZapDesk subject carries `[ZapDesk #id]` it
# lands as a comment on the ticket that produced it -- which sends another
# notification, forever.
SUPPORT_TEAM_NOTIFY_EMAIL=support-team@yourdomain.com

# =============================================================================
# Email Routing Configuration
# =============================================================================
# Email routing is configured via Azure DevOps project descriptions.
# Add "Email: domain1.com, domain2.com" to a project's description to route
# emails from those domains to that project.
#
# Example project description:
#   "Customer support project for Contoso Ltd. Email: contoso.com"
#
# The system queries DevOps every 5 minutes to update the routing map.

# =============================================================================
# GitHub Links (optional)
# =============================================================================
# Repository that the app's "request support" links file issues against.
# Defaults to this repository; set it when running a fork so those links come
# back to you rather than upstream. Must be an http(s) URL -- the value is used
# directly as a link target, so anything else is ignored.
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/your-org/zapdesk

# =============================================================================
# GitHub Issues (optional)
# =============================================================================
# Show GitHub issues beside Azure DevOps work items in the tickets list.
# Both values are needed; with either unset the feature is off and ZapDesk
# looks exactly as it does without it. See docs/SETUP.adoc, "GitHub Issues".
#
# Token used by the server to read issues. A fine-grained token with read-only
# "Issues" access to the mapped repositories is enough. Never exposed to the
# browser.
# GITHUB_TOKEN=
#
# Which repositories belong to which Azure DevOps project, as JSON. A user sees
# a repository's issues only if they can see the project it is mapped to.
# "your-org/*" stands for every repository of that GitHub organization.
# GITHUB_PROJECT_REPOS={"Project Name": ["your-org/*"]}
# GITHUB_PROJECT_REPOS={"Project Name": ["your-org/repo-one", "your-org/repo-two"]}
#
# Optional. Which GitHub username is which Azure DevOps user, as JSON, so a
# person's GitHub issues are listed under their DevOps name instead of twice.
# People can also save their GitHub username on their Profile page; an entry
# here wins over that, and covers people outside the tenant.
# GITHUB_USER_MAP={"github-username": "DevOps Display Name"}
#
# The ZapDesk GitHub App, so project admins connect GitHub themselves from the
# project page (see docs/SETUP.adoc). All five are needed; the webhook secret
# is optional.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=

# =============================================================================
# Team Status Thresholds (optional)
# =============================================================================
# Controls when team members are flagged as "Behind" or "Needs Attention"
# based on their ticket counts. Values below are the defaults.
# TEAM_THRESHOLD_NEEDS_ATTENTION_PENDING=5
# TEAM_THRESHOLD_NEEDS_ATTENTION_ASSIGNED=15
# TEAM_THRESHOLD_BEHIND_PENDING=2
# TEAM_THRESHOLD_BEHIND_ASSIGNED=10

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=ZapDesk
APP_URL=http://localhost:3102

# =============================================================================
# Branded Email Assets (optional)
# =============================================================================
# Logos used in outbound email. Defaults work for local dev; override them when
# outbound mail can't reach APP_URL (e.g. an internal-only deployment).
# ZAPDESK_LOGO_URL=https://cdn.example.com/zapdesk-logo.png
#
# The KnowAll AI logo is NOT shipped in this repo. Left unset, the email footer
# falls back to a "Powered by KnowAll AI" wordmark. Point this at a hosted copy
# of the real logo to show the image instead.
# KNOWALL_LOGO_URL=https://cdn.example.com/knowall-logo.png

# =============================================================================
# Debug Logging (optional)
# =============================================================================
# Verbose console tracing of the Kanban drag-and-drop state change, across the
# board component, the page handler, the API route and the DevOps service.
# Unset, it is on outside production builds. Set it to false to silence it in
# development, or to true to collect the trail from a production deployment.
# NEXT_PUBLIC_DEBUG_KANBAN=false
